# Rename to secrets.toml for local use, or paste these lines into the
# "Secrets" box in Streamlit Community Cloud. Never commit the real file.

GROQ_API_KEY = "your_groq_api_key_here"
MODEL_NAME = "openai/gpt-oss-120b"

# Set to "true" on the public demo: disables uploads and caps questions.
DEMO_MODE = "false"
MAX_QUESTIONS_PER_SESSION = "20"
