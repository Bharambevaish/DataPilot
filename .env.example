# Copy this file to ".env" and fill in your own values.
# .env is in .gitignore, so your real key is never committed.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Any Groq model that supports tool calling.
# Checked on https://console.groq.com/docs/models
MODEL_NAME=openai/gpt-oss-120b

# Maximum tool-calling rounds the agent may take before giving up.
MAX_AGENT_STEPS=6

# Safety limits for generated SQL.
MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=10

# Public-demo mode: no uploads, samples only, question cap per session.
DEMO_MODE=false
MAX_QUESTIONS_PER_SESSION=20
MAX_UPLOAD_MB=10
